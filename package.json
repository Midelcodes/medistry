{
  "name": "medical",
  "version": "1.0.0",
  "description": "Patient medical-record portability platform with an audited emergency break-glass scan (synthetic-data demo).",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env --experimental-strip-types src/server.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "seed": "node --env-file-if-exists=.env --experimental-strip-types scripts/seed.ts",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "6.19.3",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  }
}
