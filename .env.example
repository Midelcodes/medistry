# MEDISTRY Environment Configuration

# Application & Regional Deployment
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# ISO 3166-1 alpha-2. New patients and records default to it; /api/health reports its regulator.
# Clinician licensing rules exist for NG (MDCN) and KE (KMPDC, manual demo only; format not confirmed).
DEPLOYMENT_COUNTRY=NG
DEPLOYMENT_REGION=africa-south1

# Database & Cache
DATABASE_URL="postgresql://medistry:medistry_secure_dev@localhost:5432/medistry?schema=public"
REDIS_URL="redis://localhost:6379"

# Cryptographic Keys. Generate each with: openssl rand -hex 32
# Leave blank for local dev and a random per-process key is used (sessions reset on restart).
# Never commit real values; .env is git-ignored.
# 32-byte hex key for AES-256-GCM field-level clinical encryption
FIELD_ENCRYPTION_KEY=
# Secret for session tokens
JWT_SECRET=
# DEPRECATED and ignored: offline cards are no longer HMAC-signed. Use OFFLINE_CARD_PRIVATE_KEY.
OFFLINE_CARD_SIGNING_KEY=

# Offline emergency card signing (ES256, ECDSA P-256). Generate with: node scripts/gen-card-key.mjs
# PKCS8 private key as PEM or base64. Blank in dev = random per-process key (cards stop verifying on restart).
# Required when NODE_ENV=production and DEMO_MODE=0 (the server refuses to start without it).
OFFLINE_CARD_PRIVATE_KEY=
# Optional, for key rotation: comma-separated SPKI public keys (base64 or PEM) still accepted for verification.
OFFLINE_CARD_PREVIOUS_PUBLIC_KEYS=
OFFLINE_CARD_VALIDITY_DAYS=180

# Security & Rate Limiting Thresholds
MAX_EMERGENCY_ATTEMPTS=5
EMERGENCY_LOCKOUT_SECONDS=3600
SESSION_TIMEOUT_MINUTES=15
BREAK_GLASS_GRANT_TTL_MINUTES=60

# Notification Providers (console for local dev, twilio/africastalking for production)
SMS_PROVIDER=console
EMAIL_PROVIDER=console
PUSH_PROVIDER=console

# Demo mode (default on). Set DEMO_MODE=0 to disable the unauthenticated patient directory,
# patient portal and card generators. Required for any deployment with real data.
DEMO_MODE=1
# Set to 1 when behind exactly one reverse proxy (Railway is detected automatically).
TRUST_PROXY=0

# MCP agent (mcp/src/agent.js): Gemini function calling. Set in the environment, never commit real values.
GEMINI_API_KEY=
GEMINI_MODEL=
