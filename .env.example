# MEDISTRY Environment Configuration

# Application & Regional Deployment
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
DEPLOYMENT_COUNTRY=NG
DEPLOYMENT_REGION=africa-south1

# Database & Cache
DATABASE_URL="postgresql://medistry:medistry_secure_dev@localhost:5432/medistry?schema=public"
REDIS_URL="redis://localhost:6379"

# Cryptographic Keys. Generate each with: openssl rand -hex 32
# Leave blank for local dev and a random per-process key is used (sessions reset on restart).
# Never commit real values; .env is git-ignored.
# 32-byte hex key for AES-256-GCM field-level clinical encryption
FIELD_ENCRYPTION_KEY=
# Secret for session tokens and offline QR signature
JWT_SECRET=
OFFLINE_CARD_SIGNING_KEY=

# Security & Rate Limiting Thresholds
MAX_EMERGENCY_ATTEMPTS=5
EMERGENCY_LOCKOUT_SECONDS=3600
SESSION_TIMEOUT_MINUTES=15
BREAK_GLASS_GRANT_TTL_MINUTES=60

# Notification Providers (console for local dev, twilio/africastalking for production)
SMS_PROVIDER=console
EMAIL_PROVIDER=console
PUSH_PROVIDER=console

# Demo mode (default on). Set DEMO_MODE=0 to disable the unauthenticated patient directory,
# patient portal and card generators. Required for any deployment with real data.
DEMO_MODE=1
# Set to 1 when behind exactly one reverse proxy (Railway is detected automatically).
TRUST_PROXY=0

# MCP agent (mcp/src/agent.js): Gemini function calling. Set in the environment, never commit real values.
GEMINI_API_KEY=
GEMINI_MODEL=
