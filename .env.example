# MEDISTRY Environment Configuration

# Application & Regional Deployment
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# ISO 3166-1 alpha-2. New patients and records default to it; /api/health reports its regulator.
# Clinician licensing rules exist for NG (MDCN) and KE (KMPDC, manual demo only; format not confirmed).
DEPLOYMENT_COUNTRY=NG
# In-country hosting region. DEPLOYMENT_COUNTRY and DEPLOYMENT_REGION are required when DEMO_MODE=0 (docs/DEPLOYMENT.md).
DEPLOYMENT_REGION=
DEPLOYMENT_REGION=africa-south1

# Database & Cache
# Storage: memory (default, nothing persists) or postgres (needs DATABASE_URL, the secrets below, then `npm run seed`).
STORAGE=memory
DATABASE_URL="postgresql://medistry:medistry_secure_dev@localhost:5432/medistry?schema=public"
REDIS_URL="redis://localhost:6379"

# Cryptographic Keys. Generate each with: openssl rand -hex 32
# Leave blank for local dev and a random per-process key is used (sessions reset on restart).
# Never commit real values; .env is git-ignored.
# 32-byte hex key for AES-256-GCM field-level clinical encryption
FIELD_ENCRYPTION_KEY=
# Field key rotation (docs/DEPLOYMENT.md section 4): version of FIELD_ENCRYPTION_KEY, and older keys still readable
# as <version>:<64 hex>,... Re-encrypt with scripts/rotate-field-key.ts, then drop the old key.
FIELD_ENCRYPTION_KEY_VERSION=1
# Blind index for national identifiers (exact-match lookup without decrypting). A separate 64-hex key, never the
# field key. Required with STORAGE=postgres. Changing it needs a re-index (TODO).
IDENTITY_INDEX_KEY=
# Duplicate review threshold (0.6-0.99; default 0.8) and FHIR identifier-system aliases for national IDs
# ("<system uri>=<country>:<idType>,...", e.g. one used by an EMR for the NIN).
MPI_REVIEW_THRESHOLD=
IDENTITY_FHIR_SYSTEMS=
FIELD_ENCRYPTION_PREVIOUS_KEYS=
# env (keys from this file) or cloud-kms (stub, not implemented yet).
KEY_PROVIDER=env
# Secret for session tokens
JWT_SECRET=
# DEPRECATED and ignored: offline cards are no longer HMAC-signed. Use OFFLINE_CARD_PRIVATE_KEY.
OFFLINE_CARD_SIGNING_KEY=

# Offline emergency card signing (ES256, ECDSA P-256). Generate with: node scripts/gen-card-key.mjs
# PKCS8 private key as PEM or base64. Blank in dev = random per-process key (cards stop verifying on restart).
# Required when NODE_ENV=production and DEMO_MODE=0 (the server refuses to start without it).
OFFLINE_CARD_PRIVATE_KEY=
# Optional, for key rotation: comma-separated SPKI public keys (base64 or PEM) still accepted for verification.
# Each entry may end in @<ISO date>: the key leaves the JWKS after that date (when its last card has expired).
OFFLINE_CARD_PREVIOUS_PUBLIC_KEYS=
OFFLINE_CARD_VALIDITY_DAYS=180

# Security & Rate Limiting Thresholds
# Sign-in lockout after 5 failed attempts (clinicians, admins), in seconds. Replaces EMERGENCY_LOCKOUT_SECONDS.
ACCOUNT_LOCKOUT_SECONDS=3600
SESSION_TIMEOUT_MINUTES=15
BREAK_GLASS_GRANT_TTL_MINUTES=60

# Notification Providers. SMS_PROVIDER=console (default: messages stay in memory) or africastalking.
# Email and push use the console provider for now.
SMS_PROVIDER=console
# Africa's Talking (SMS_PROVIDER=africastalking). In the sandbox the username is always "sandbox".
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
AT_ENV=sandbox
# Recipient statusCode values treated as "accepted" in the send response (TODO: confirm the list against the docs).
AT_ACCEPTED_STATUS_CODES=101
# Shared secrets (32+ random characters, openssl rand -hex 24) for provider callbacks. Put them in the callback
# URLs you register with the provider: /api/webhooks/sms/delivery/<SMS_WEBHOOK_SECRET> and /api/ussd/<USSD_CALLBACK_SECRET>.
SMS_WEBHOOK_SECRET=
USSD_CALLBACK_SECRET=
# USSD short code shown in SMS alerts, e.g. *123*45#. TODO: must be provisioned with the provider and telcos.
USSD_SERVICE_CODE=
EMAIL_PROVIDER=console
PUSH_PROVIDER=console

# Patient sign-in codes (SMS): requests allowed per phone number and per IP address in 15 minutes.
OTP_MAX_PER_PHONE=3
OTP_MAX_PER_IP=10
# Days before a recorded licence expiry date to send a clinician a re-verification reminder.
LICENCE_REMINDER_DAYS=30
# First platform admin (created once, at start-up). Generate the values with:
#   node --experimental-strip-types scripts/admin-credentials.ts   (reads the password from stdin)
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD_HASH=
PLATFORM_ADMIN_TOTP_SECRET=

# Demo mode (default on). Set DEMO_MODE=0 to disable the unauthenticated patient directory and card
# generators: the patient portal then needs a phone sign-in, clinicians need a password and an authenticator,
# and the demo authenticator endpoint is off. Required for any deployment with real data.
DEMO_MODE=1
# Set to 1 when behind exactly one reverse proxy (Railway is detected automatically).
TRUST_PROXY=0

# MCP agent (mcp/src/agent.js): Gemini function calling. Set in the environment, never commit real values.
GEMINI_API_KEY=
GEMINI_MODEL=
# With DEMO_MODE=0 the agent refuses to run unless the model is in-country and approved (docs/DEPLOYMENT.md).
LLM_IN_COUNTRY_APPROVED=

# AI intake (clinician intake from paper or voice). Default: a deterministic local stand-in. A real model only when
# INTAKE_LLM_PROVIDER=http is set, and with DEMO_MODE=0 only with LLM_IN_COUNTRY_APPROVED=1 (docs/DEPLOYMENT.md).
INTAKE_LLM_PROVIDER=
INTAKE_LLM_URL=
INTAKE_LLM_API_KEY=
INTAKE_LLM_MODEL=

# EMR integration: facility API client token lifetime (seconds), and the OpenMRS (KenyaEMR) pull connector.
API_TOKEN_TTL_SECONDS=300
OPENMRS_BASE_URL=
OPENMRS_USERNAME=
OPENMRS_PASSWORD=

# National health information exchanges (Phase 17). Adapters only: TODO obtain sandbox access and conformance
# requirements from each agency. HTTPS base URL, credentials, facility code and the FHIR identifier system per ID type
# all come from here; nothing is sent while BASE_URL is empty.
HIE_KE_BASE_URL=
HIE_KE_ACCESS_TOKEN=
HIE_KE_FACILITY_CODE=
HIE_KE_ID_SYSTEM_NATIONAL_ID=
HIE_NG_BASE_URL=
HIE_NG_ACCESS_TOKEN=
HIE_NG_FACILITY_CODE=
HIE_NG_ID_SYSTEM_NIN=
# Outbox worker: poll interval, attempts before dead-letter, first retry delay (doubles each time).
OUTBOX_POLL_SECONDS=30
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BASE_SECONDS=60
# How long a pharmacy's consent lasts (hours; the patient can revoke it any time).
PHARMACY_ACCESS_HOURS=12

# Malware scanning: clamd over TCP. Required with DEMO_MODE=0 (uploads are rejected if clamd is unreachable).
CLAMD_HOST=
CLAMD_PORT=3310
UPLOAD_MAX_MB=10

# Backups (scripts/backup.sh): encrypted to a GPG public key; the private key stays with the backup custodian.
BACKUP_DIR=
BACKUP_GPG_RECIPIENT=
BACKUP_KEEP_DAYS=14

# Facility onboarding (Phase 18): how long a staff invitation link stays valid (hours, 1 to 168).
FACILITY_INVITE_HOURS=72

# Billing (Phase 18). TEST / SANDBOX MODE ONLY in this build: a live Paystack key (sk_live_...) or DARAJA_ENV other
# than sandbox is refused. TODO: obtain the test credentials from each provider's dashboard; never commit them.
# Plans and placeholder prices: src/config/plans.json (TODO: set the real prices). Patients are never charged.
# Paystack (Nigeria): test secret key, and the webhook signing secret (whsec_...) for the Paystack-Signature header.
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
# M-Pesa Daraja (Kenya): sandbox app credentials, the shortcode and its Lipa na M-Pesa passkey. Daraja callbacks are
# not signed, so DARAJA_CALLBACK_SECRET (32+ random characters) goes in the callback URL path and is checked.
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORT_CODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_SECRET=
