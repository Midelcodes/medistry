# MEDISTRY Environment Configuration

# Application & Regional Deployment
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
DEPLOYMENT_COUNTRY=NG
DEPLOYMENT_REGION=africa-south1

# Database & Cache
DATABASE_URL="postgresql://medistry:medistry_secure_dev@localhost:5432/medistry?schema=public"
REDIS_URL="redis://localhost:6379"

# Cryptographic Keys (Field-Level Encryption & Token Signatures)
# 32-byte hex key for AES-256-GCM field-level clinical encryption
FIELD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Secret for session tokens and offline QR signature
JWT_SECRET=super_secret_jwt_hmac_key_min_32_characters_long_for_security
OFFLINE_CARD_SIGNING_KEY=offline_ecdsa_or_hmac_signing_key_for_emergency_qr_cards

# Security & Rate Limiting Thresholds
MAX_EMERGENCY_ATTEMPTS=5
EMERGENCY_LOCKOUT_SECONDS=3600
SESSION_TIMEOUT_MINUTES=15
BREAK_GLASS_GRANT_TTL_MINUTES=60

# Notification Providers (console for local dev, twilio/africastalking for production)
SMS_PROVIDER=console
EMAIL_PROVIDER=console
PUSH_PROVIDER=console

